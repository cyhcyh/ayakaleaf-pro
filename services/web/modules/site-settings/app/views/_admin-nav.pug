include ../../../../app/views/_mixins/material_symbol
aside.rogerleaf-admin-sidebar
	nav.rogerleaf-admin-nav(aria-label=translate('rogerleaf_admin_navigation'))
		a(href='/admin' aria-current='page')
			+material-symbol('home')
			span= translate('rogerleaf_site_settings')
		a(href='/admin/user')
			+material-symbol('group')
			span= translate('ayaka_manage_users')
		a(href='/admin/project')
			+material-symbol('folder')
			span= translate('ayaka_manage_projects')
		a(href='/admin/integrations')
			+material-symbol('settings')
			span= translate('ayaka_integrations_configuration')
	a.rogerleaf-admin-back(href='/project')
		+material-symbol('arrow_back')
		span= translate('rogerleaf_back_to_projects')
